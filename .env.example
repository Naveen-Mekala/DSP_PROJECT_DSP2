POSTGRES_USER=athlete
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_DB=athlete_db
DATABASE_URL=postgresql://athlete:change-this-local-password@postgres:5432/athlete_db
AIRFLOW_FERNET_KEY=
AIRFLOW_API_SECRET_KEY=replace-with-a-long-random-secret
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=dsp2026team
GRAFANA_USER=admin
GRAFANA_PASSWORD=dsp2026team
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_REGISTERED_MODEL=AthleteRecoveryModel
DRIFT_PSI_THRESHOLD=0.2
DRIFT_WINDOW=500

# Microsoft Teams incoming webhooks (Teams channel > Workflows > "Post to a channel when a webhook
# request is received", or a classic Incoming Webhook connector). Leave empty to only log alerts.
TEAMS_DATA_WEBHOOK_URL=
TEAMS_ML_WEBHOOK_URL=
# Links shown in alerts (must be reachable from your browser)
DATA_DOCS_BASE_URL=http://localhost:8088
MLFLOW_UI_URL=http://localhost:5001
# Schedules and training rules
INGESTION_SCHEDULE=*/5 * * * *
PREDICTION_SCHEDULE=*/5 * * * *
TRAINING_SCHEDULE=0 * * * *
MIN_NEW_TRAINING_ROWS=100
MAX_INFERENCE_MS_PER_ROW=10
