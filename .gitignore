# Secrets and local environments
.env
.env.*
!.env.example
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.DS_Store

# Data produced by the running pipeline (folders are kept with .gitkeep)
data/raw_data/*.csv
data/good_data/*.csv
data/bad_data/*.csv
data/archived_data/*.csv
data/corrupted/*.csv
data/training_runs/
data/prediction_results.csv
data/prediction_processed*
data/.prediction_processed

# Model artifacts: only the fallback model is versioned (lets a fresh clone start)
models/*.pkl
models/*.pkl.gz
!models/model.pkl.gz
!models/.gitkeep
mlruns/
mlartifacts/

# Great Expectations generated files (validation results, Data Docs)
gx/gx/uncommitted/

# Logs
airflow/logs/

# Local safety backups (not part of the deliverable)
backups/
