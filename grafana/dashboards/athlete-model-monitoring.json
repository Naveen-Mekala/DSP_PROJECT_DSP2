        "textMode": "value"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Drifted features (latest check)",
      "description": "",
      "datasource": {
        "type": "postgres",
        "uid": "athlete-postgres"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "athlete-postgres"
          },
          "rawSql": "SELECT count(*) AS value FROM drift_stats WHERE is_drifted = 1 AND measured_at = (SELECT max(measured_at) FROM drift_stats)",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
