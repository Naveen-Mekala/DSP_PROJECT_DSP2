        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "athlete-postgres"
          },
          "rawSql": "SELECT 'v' || model_version AS value FROM predictions ORDER BY prediction_time DESC LIMIT 1",
          "format": "table",
