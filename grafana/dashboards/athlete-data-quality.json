{
  "uid": "athlete-data-quality",
  "title": "Athlete Recovery — Data Quality",
  "tags": [
    "dsp",
    "data-quality"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {},
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Files ingested",
      "description": "",
      "datasource": {
        "type": "postgres",
        "uid": "athlete-postgres"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "athlete-postgres"
          },
          "rawSql": "SELECT count(*) AS value FROM ingestion_stats WHERE $__timeFilter(ingestion_time)",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": null,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Rows ingested",
      "description": "",
      "datasource": {
        "type": "postgres",
        "uid": "athlete-postgres"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "athlete-postgres"
          },
          "rawSql": "SELECT COALESCE(sum(total_rows), 0) AS value FROM ingestion_stats WHERE $__timeFilter(ingestion_time)",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": null,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Invalid rows",
      "description": "",
      "datasource": {
        "type": "postgres",
        "uid": "athlete-postgres"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "athlete-postgres"
          },
          "rawSql": "SELECT COALESCE(100.0 * sum(invalid_rows) / NULLIF(sum(total_rows), 0), 0) AS value FROM ingestion_stats WHERE $__timeFilter(ingestion_time)",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 10
              },
              {
                "color": "red",
                "value": 50
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "High-criticality files",
      "description": "",
      "datasource": {
        "type": "postgres",
        "uid": "athlete-postgres"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "athlete-postgres"
          },
          "rawSql": "SELECT count(*) AS value FROM ingestion_stats WHERE $__timeFilter(ingestion_time) AND criticality = 'High'",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": null,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Valid vs invalid rows",
      "description": "Rows per interval, split by the ingestion job into good_data and bad_data.",
      "datasource": {
        "type": "postgres",
        "uid": "athlete-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "athlete-postgres"
          },
          "rawSql": "SELECT $__timeGroupAlias(ingestion_time, $__interval), sum(valid_rows) AS \"Valid\", sum(invalid_rows) AS \"Invalid\" FROM ingestion_stats WHERE $__timeFilter(ingestion_time) GROUP BY 1 ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 2,
            "fillOpacity": 70,
            "pointSize": 6,
            "showPoints": "auto",
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "spanNulls": true
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Valid"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Invalid"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Errors by category",
      "description": "Completeness = missing values; Validity = out-of-range values and unknown categories; Consistency = duplicated (Athlete_ID, Day); Schema = missing/unexpected columns; Type = text in numeric columns.",
      "datasource": {
        "type": "postgres",
        "uid": "athlete-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "athlete-postgres"
          },
          "rawSql": "SELECT $__timeGroupAlias(ingestion_time, $__interval), sum(missing_values) AS \"Completeness\", sum(invalid_ranges + invalid_categories + outliers) AS \"Validity\", sum(duplicate_ids) AS \"Consistency\", sum(missing_columns) AS \"Schema\", sum(wrong_data_types) AS \"Type\" FROM ingestion_stats WHERE $__timeFilter(ingestion_time) GROUP BY 1 ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 2,
            "fillOpacity": 70,
            "pointSize": 6,
            "showPoints": "auto",
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "spanNulls": true
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Completeness"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Validity"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Consistency"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Schema"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Type"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Invalid rows per file (%)",
      "description": "One point per ingested file. Above 50% the file is High criticality.",
      "datasource": {
        "type": "postgres",
        "uid": "athlete-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "athlete-postgres"
          },
          "rawSql": "SELECT ingestion_time AS time, invalid_percentage AS \"Invalid %\" FROM ingestion_stats WHERE $__timeFilter(ingestion_time) ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": {
            "drawStyle": "points",
            "lineWidth": 2,
            "fillOpacity": 10,
            "pointSize": 6,
            "showPoints": "auto",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "spanNulls": true,
            "thresholdsStyle": {
              "mode": "line+area"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 50
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Files per criticality",
      "description": "Medium and High files trigger a Teams alert on the data channel.",
      "datasource": {
        "type": "postgres",
        "uid": "athlete-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "athlete-postgres"
          },
          "rawSql": "SELECT $__timeGroupAlias(ingestion_time, $__interval), sum(CASE WHEN criticality = 'None' THEN 1 ELSE 0 END) AS \"None\", sum(CASE WHEN criticality = 'Low' THEN 1 ELSE 0 END) AS \"Low\", sum(CASE WHEN criticality = 'Medium' THEN 1 ELSE 0 END) AS \"Medium\", sum(CASE WHEN criticality = 'High' THEN 1 ELSE 0 END) AS \"High\" FROM ingestion_stats WHERE $__timeFilter(ingestion_time) GROUP BY 1 ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 2,
            "fillOpacity": 70,
            "pointSize": 6,
            "showPoints": "auto",
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "spanNulls": true
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "None"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Low"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Medium"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "High"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "Ingested files (latest first)",
      "description": "Click a Report cell to open that file's Great Expectations validation report.",
      "datasource": {
        "type": "postgres",
        "uid": "athlete-postgres"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "athlete-postgres"
          },
          "rawSql": "SELECT ingestion_time AS \"Time\", filename AS \"File\", total_rows AS \"Rows\", invalid_rows AS \"Invalid rows\", invalid_percentage AS \"Invalid %\", criticality AS \"Criticality\", missing_values AS \"Completeness\", invalid_ranges + invalid_categories + outliers AS \"Validity\", duplicate_ids AS \"Consistency\", missing_columns AS \"Schema\", wrong_data_types AS \"Type\", report_file AS \"Report\" FROM ingestion_stats WHERE $__timeFilter(ingestion_time) ORDER BY ingestion_time DESC LIMIT 200",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Report"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open Data Docs report",
                    "url": "${__value.raw}",
                    "targetBlank": true
                  }
                ]
              },
              {
                "id": "custom.width",
                "value": 140
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Criticality"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "None": {
                        "color": "green",
                        "index": 0
                      },
                      "Low": {
                        "color": "yellow",
                        "index": 1
                      },
                      "Medium": {
                        "color": "orange",
                        "index": 2
                      },
                      "High": {
                        "color": "red",
                        "index": 3
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        }
      }
    }
  ]
}
